# Production settings. Do NOT fill this in by hand: run
#
#     deltaflow gen-env --domain <your-hostname> --email <you@example.com>
#
# which writes .env.prod with freshly generated secrets. This file only documents the variables
# (and lets CI validate docker-compose.prod.yml). Never commit .env.prod.

# Public hostname Caddy gets a certificate for. Free option: <vm-public-ip-with-dashes>.sslip.io
DOMAIN=deltaflow.example.com
ACME_EMAIL=you@example.com

# Image tag to run (a release such as v1.0.0, or "latest").
DELTAFLOW_VERSION=latest

POSTGRES_USER=deltaflow
POSTGRES_DB=shop
POSTGRES_PASSWORD=change-me
ELASTIC_PASSWORD=change-me
MONGO_ROOT_USER=deltaflow
MONGO_ROOT_PASSWORD=change-me

# Required on every API route except /health. Send as "X-API-Key: ..." or "Authorization: Bearer ...".
DELTAFLOW_API_KEY=change-me
