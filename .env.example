# Copy to .env (never commit .env). Defaults work for local development.

# docker-compose (Postgres bootstrap)
POSTGRES_USER=deltaflow
POSTGRES_PASSWORD=deltaflow
POSTGRES_DB=shop

# Deltaflow application (read by deltaflow.config.Settings)
DELTAFLOW_ENVIRONMENT=development
DELTAFLOW_LOG_LEVEL=INFO
DELTAFLOW_POSTGRES_DSN=postgresql://deltaflow:deltaflow@localhost:5432/shop
DELTAFLOW_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
DELTAFLOW_CONNECT_URL=http://localhost:8083
DELTAFLOW_ELASTICSEARCH_URL=http://localhost:9200
DELTAFLOW_MONGO_URL=mongodb://localhost:27017
DELTAFLOW_MONGO_DATABASE=deltaflow
