# Copy to .env (never commit .env). Defaults work for local development.

# docker-compose (Postgres bootstrap)
POSTGRES_USER=deltaflow
POSTGRES_PASSWORD=deltaflow
POSTGRES_DB=shop

# Deltaflow application (read by deltaflow.config.Settings)
DELTAFLOW_ENVIRONMENT=development
DELTAFLOW_LOG_LEVEL=INFO
DELTAFLOW_POSTGRES_DSN=postgresql://deltaflow:deltaflow@127.0.0.1:5432/shop
DELTAFLOW_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
DELTAFLOW_CONNECT_URL=http://127.0.0.1:8083
DELTAFLOW_ELASTICSEARCH_URL=http://127.0.0.1:9200
DELTAFLOW_MONGO_URL=mongodb://127.0.0.1:27017
DELTAFLOW_MONGO_DATABASE=deltaflow

# Host port overrides, only needed when a default port is already in use on your machine
# (if you change MONGO_HOST_PORT, also change DELTAFLOW_MONGO_URL to match).
# POSTGRES_HOST_PORT=5432
# KAFKA_HOST_PORT=29092   (the advertised address stays 127.0.0.1:29092, so leave this one alone)
# CONNECT_HOST_PORT=8083
# ELASTICSEARCH_HOST_PORT=9200
# MONGO_HOST_PORT=27017
# API_HOST_PORT=8000

# Optional: require X-API-Key on connector control endpoints (leave unset for local dev)
# DELTAFLOW_API_KEY=
# PROMETHEUS_HOST_PORT=9090

# Production only (see docs/deployment.md; `deltaflow gen-env` writes these for you):
# DELTAFLOW_AUTH_REQUIRED=true            API refuses to start without DELTAFLOW_API_KEY
# DELTAFLOW_ELASTICSEARCH_USER=elastic
# DELTAFLOW_ELASTICSEARCH_PASSWORD=
